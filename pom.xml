<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.3</version>
        <relativePath/>
    </parent>

    <groupId>cc.projectargus</groupId>
    <artifactId>libargus-spring-boot-example</artifactId>
    <version>2.3.1</version>
    <name>Local AI Workbench (libargus Spring Boot Example)</name>
    <description>Standalone Spring Boot Local AI Workbench demonstrating in-process GGUF inference, streaming, and cooperative cancellation with libargus and LangChain4j.</description>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Pinned libargus & LangChain4j coordinates -->
        <libargus.version>2.3.1</libargus.version>
        <langchain4j.version>1.1.0</langchain4j.version>

        <!-- Default FFI binding on JDK 17-21 (auto-shifts to libargus-core Panama FFM on JDK 22+; override via -Pjni) -->
        <libargus.binding.artifact>libargus-jni</libargus.binding.artifact>
        <argus.jvm.args></argus.jvm.args>

        <!-- Default CPU-first native provider (override via -P<profile> or -Dlibargus.native.artifact=...) -->
        <libargus.native.artifact>libargus-native-linux-cpu</libargus.native.artifact>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-core</artifactId>
                <version>${langchain4j.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Spring Boot Web (MVC + Embedded Tomcat + SSE) & Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- libargus LangChain4j adapter + active FFI binding (JNI on JDK 17-21, Panama FFM on JDK 22+) -->
        <dependency>
            <groupId>cc.projectargus</groupId>
            <artifactId>libargus-langchain4j</artifactId>
            <version>${libargus.version}</version>
        </dependency>
        <dependency>
            <groupId>cc.projectargus</groupId>
            <artifactId>${libargus.binding.artifact}</artifactId>
            <version>${libargus.version}</version>
        </dependency>

        <!-- Platform/backend-specific native library provider (default: Linux CPU) -->
        <dependency>
            <groupId>cc.projectargus</groupId>
            <artifactId>${libargus.native.artifact}</artifactId>
            <version>${libargus.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- Automatically shifts to Project Panama FFM (libargus-core) when JDK 22+ is detected -->
        <profile>
            <id>panama</id>
            <activation>
                <jdk>[22,)</jdk>
            </activation>
            <properties>
                <java.version>22</java.version>
                <maven.compiler.release>22</maven.compiler.release>
                <libargus.binding.artifact>libargus-core</libargus.binding.artifact>
                <argus.jvm.args>--enable-native-access=ALL-UNNAMED</argus.jvm.args>
            </properties>
        </profile>
        <!-- Explicit override (-Pjni) to force portable JDK 17 JNI bytecode & binding even on JDK 22+ -->
        <profile>
            <id>jni</id>
            <properties>
                <java.version>17</java.version>
                <maven.compiler.release>17</maven.compiler.release>
                <libargus.binding.artifact>libargus-jni</libargus.binding.artifact>
            </properties>
        </profile>
        <profile>
            <id>linux-cpu</id>
            <properties>
                <libargus.native.artifact>libargus-native-linux-cpu</libargus.native.artifact>
            </properties>
        </profile>
        <profile>
            <id>linux-cuda</id>
            <properties>
                <libargus.native.artifact>libargus-native-linux-cuda</libargus.native.artifact>
            </properties>
        </profile>
        <profile>
            <id>linux-rocm</id>
            <properties>
                <libargus.native.artifact>libargus-native-linux-rocm</libargus.native.artifact>
            </properties>
        </profile>
        <profile>
            <id>linux-vulkan</id>
            <properties>
                <libargus.native.artifact>libargus-native-linux-vulkan</libargus.native.artifact>
            </properties>
        </profile>
        <profile>
            <id>windows-cpu</id>
            <properties>
                <libargus.native.artifact>libargus-native-windows-cpu</libargus.native.artifact>
            </properties>
        </profile>
        <profile>
            <id>windows-cuda</id>
            <properties>
                <libargus.native.artifact>libargus-native-windows-cuda</libargus.native.artifact>
            </properties>
        </profile>
        <profile>
            <id>windows-vulkan</id>
            <properties>
                <libargus.native.artifact>libargus-native-windows-vulkan</libargus.native.artifact>
            </properties>
        </profile>
        <profile>
            <id>macos-metal</id>
            <properties>
                <libargus.native.artifact>libargus-native-macos-metal</libargus.native.artifact>
            </properties>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>${argus.jvm.args}</argLine>
                    <systemPropertyVariables>
                        <argus.chat.model-path>${env.ARGUS_CHAT_MODEL_PATH}</argus.chat.model-path>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <jvmArguments>${argus.jvm.args}</jvmArguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
